  Ann {* + iJTAG Shift-DR SIB network: 64-bit, open SIB[1] *}
  Ann {* iJTAG SIB[0]=CLOSED *}
  Ann {* "cycle_number:44 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* iJTAG SIB[1]=OPEN *}
  Ann {* "cycle_number:45 vector_type:TEST_SETUP" *}
