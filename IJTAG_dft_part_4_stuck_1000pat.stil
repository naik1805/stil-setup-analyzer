STIL 1.0;

Header  {
Title "DFT_dft_part_4_stuck_at_ijtag" ;
  Date     "Wed Sep 23 13:50:00 2026" ;
  Source  "synthetic iJTAG DFT partition kit" ;
  History  {
    Ann {*  Begin_Verify_Section  *}
    Ann {*    format            = STIL  *}
    Ann {*    test_set_type     = IJTAG_SCAN_TEST  *}
    Ann {*    fault_model       = stuck  *}
    Ann {*    dft_partition     = dft_part_4  *}
    Ann {*    ijtag_sib_select  = 00001  *}
    Ann {*    ijtag_tdr         = 01000001  *}
    Ann {*    pattern_begin     = 0  *}
    Ann {*    pattern_end     = 999  *}
    Ann {*    one_setup         = ON  *}
    Ann {*  End_Verify_Section  *}
  }
}

Signals {
  "RESET" In;
  "TCK" In;
  "TMS" In;
  "TDI" In;
  "TRST" In;
  "CLK" In;
  "SE" In;
  "scan_in_0" In;
  "scan_in_1" In;
  "scan_in_2" In;
  "scan_in_3" In;
  "TDO" Out;
  "scan_out_0" Out;
  "scan_out_1" Out;
  "scan_out_2" Out;
  "scan_out_3" Out;
}

SignalGroups {
  "_si_" = '"scan_in_0" + "scan_in_1" + "scan_in_2" + "scan_in_3"';
  "_so_" = '"scan_out_0" + "scan_out_1" + "scan_out_2" + "scan_out_3"';
  "_jtag_" = '"TCK" + "TMS" + "TDI" + "TDO" + "TRST"';
  "si_0" = '"scan_in_0"' {ScanIn 32;}
  "so_0" = '"scan_out_0"' {ScanOut 32;}
  "si_1" = '"scan_in_1"' {ScanIn 32;}
  "so_1" = '"scan_out_1"' {ScanOut 32;}
  "si_2" = '"scan_in_2"' {ScanIn 32;}
  "so_2" = '"scan_out_2"' {ScanOut 32;}
  "si_3" = '"scan_in_3"' {ScanIn 32;}
  "so_3" = '"scan_out_3"' {ScanOut 32;}
}

Timing {
  WaveformTable WFT_50MHZ {
    Period '20ns' ;
    Waveforms {
      "RESET" { 01 { '0ns' D/U; }}
      "TCK"   { 01 { '0ns' D; '10ns' D/U; '18ns' D; }}
      "TMS"   { 01 { '2ns' D/U; }}
      "TDI"   { 01 { '2ns' D/U; }}
      "TRST"  { 01 { '0ns' D/U; }}
      "CLK"   { 01 { '0ns' D; '10ns' D/U; '18ns' D; }}
      "SE"    { 01 { '0ns' D/U; }}
      "_si_"  { 01 { '2ns' D/U; }}
      "TDO"   { LHX { '0ns' X; '12ns' L/H/X; '14ns' X; }}
      "_so_"  { LHX { '0ns' X; '12ns' L/H/X; '14ns' X; }}
    }
  }
}

ScanStructures {
  ScanChain dft_part_4_ch0 {
      ScanLength 32;
      ScanInversion 0;
      ScanIn "scan_in_0";
      ScanOut "scan_out_0";
      ScanMasterClock "CLK";
  }
  ScanChain dft_part_4_ch1 {
      ScanLength 32;
      ScanInversion 0;
      ScanIn "scan_in_1";
      ScanOut "scan_out_1";
      ScanMasterClock "CLK";
  }
  ScanChain dft_part_4_ch2 {
      ScanLength 32;
      ScanInversion 0;
      ScanIn "scan_in_2";
      ScanOut "scan_out_2";
      ScanMasterClock "CLK";
  }
  ScanChain dft_part_4_ch3 {
      ScanLength 32;
      ScanInversion 0;
      ScanIn "scan_in_3";
      ScanOut "scan_out_3";
      ScanMasterClock "CLK";
  }
}

MacroDefs {
  "scan_shift" {
    W WFT_50MHZ;
    Shift { V { "si_0" = #; "so_0" = #; "si_1" = #; "so_1" = #; "si_2" = #; "so_2" = #; "si_3" = #; "so_3" = #; "CLK" = 1; } }
    W WFT_50MHZ;
  }
}

PatternBurst scanpats {
  PatList { scan_test; }
}

PatternExec {
  Timing;
  PatternBurst scanpats;
}

Pattern scan_test {
  W WFT_50MHZ;
  // ----- RESET PORTION (top) -----
  Ann {* reset_portion: assert RESET and TRST *}
  Ann {* "cycle_number:0 vector_type:TEST_SETUP" *}
  V { "RESET"=0; "TRST"=0; "TCK"=0; "TMS"=1; "TDI"=0; "SE"=0; "CLK"=0; }
  Ann {* "cycle_number:1 vector_type:TEST_SETUP" *}
  V { "RESET"=0; "TRST"=0; "TCK"=0; "TMS"=1; "TDI"=0; }
  Ann {* reset_portion: release TRST, keep RESET asserted *}
  Ann {* "cycle_number:2 vector_type:TEST_SETUP" *}
  V { "RESET"=0; "TRST"=1; "TMS"=1; "TCK"=1; }
  Ann {* reset_portion: TAP Test-Logic-Reset via TMS=1 *}
  Loop 5 {
    Ann {* "cycle_number:3 vector_type:TEST_SETUP" *}
    V { "TMS"=1; "TCK"=1; "RESET"=0; }
  }
  Ann {* reset_portion: release RESET, TAP to idle *}
  Ann {* "cycle_number:8 vector_type:TEST_SETUP" *}
  V { "RESET"=1; "TMS"=0; "TCK"=1; "TRST"=1; }
  Ann {* "cycle_number:9 vector_type:TEST_SETUP" *}
  V { "RESET"=1; "TMS"=0; "TCK"=0; }
  // ----- iJTAG PORTION: select one DFT partition -----
  Ann {* IEEE 1687 iJTAG: target partition dft_part_4 *}
  Ann {* + Shift-IR IEEE1687 access instruction *}
  Ann {* "cycle_number:10 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=1; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:11 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:12 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:13 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TCK"=1; "RESET"=1; }
  Ann {* + Exit-IR to idle *}
  Ann {* "cycle_number:14 vector_type:TEST_SETUP" *}
  V { "TMS"=1; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:15 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TCK"=1; "RESET"=1; }
  Ann {* + iJTAG Shift-DR SIB network: open SIB[4] only, vector 00001 *}
  Ann {* iJTAG SIB[0]=CLOSED *}
  Ann {* "cycle_number:16 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* iJTAG SIB[1]=CLOSED *}
  Ann {* "cycle_number:17 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* iJTAG SIB[2]=CLOSED *}
  Ann {* "cycle_number:18 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* iJTAG SIB[3]=CLOSED *}
  Ann {* "cycle_number:19 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* iJTAG SIB[4]=OPEN *}
  Ann {* "cycle_number:20 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=1; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* + iJTAG TDR config for dft_part_4 = 01000001 *}
  Ann {* "cycle_number:21 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:22 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=1; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:23 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:24 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:25 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:26 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:27 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=0; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* "cycle_number:28 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TDI"=1; "TDO"=L; "TCK"=1; "RESET"=1; }
  Ann {* + iJTAG done: scan partition dft_part_4 is the only active DFT partition *}
  Ann {* "cycle_number:29 vector_type:TEST_SETUP" *}
  V { "TMS"=1; "TCK"=1; "RESET"=1; "SE"=0; }
  Ann {* "cycle_number:30 vector_type:TEST_SETUP" *}
  V { "TMS"=0; "TCK"=0; "RESET"=1; "SE"=0; }
  // ----- STUCK-AT PAYLOAD for this partition only -----
  Ann {* "cycle_number:31 pattern_numer:0 pattern_type:stuck" *}
  Ann {* "cycle_number:31 vector_type:LOAD_UNLOAD" *}
  V { "SE"=1; "RESET"=1; "CLK"=0; }
  Macro "scan_shift" {
    "si_0" = 10101010101010101010101010101010;
    "so_0" =  \r32 X ;
    "si_1" = 10101010101010101010101010101010;
    "so_1" =  \r32 X ;
    "si_2" = 10101010101010101010101010101010;
    "so_2" =  \r32 X ;
    "si_3" = 10101010101010101010101010101010;
    "so_3" =  \r32 X ;
  }
